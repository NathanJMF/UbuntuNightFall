#!/bin/sh
set -eu
cd "$(dirname "$0")"
[ "$(id -u)" -ne 0 ] || { echo 'Run install as the desktop user.' >&2; exit 1; }
case "$(gnome-shell --version)" in 'GNOME Shell 50.'*) ;; *) echo 'Nightfall targets Ubuntu GNOME 50.' >&2; exit 1;; esac
sudo apt-get install -y yaru-theme-gtk yaru-theme-icon python3-gi python3-pil
/usr/bin/python3 theme.py install
./greeter install
printf '%s\n' 'Nightfall is installed. Sign in again to load the shell extension and Settings styling.'
